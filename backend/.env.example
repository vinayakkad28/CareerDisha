# =============================================================================
# CareerNeeti — Environment Configuration
# =============================================================================

# LLM API Keys (at least one required for report generation)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
GROQ_API_KEY=gsk_...

# Admin Auth
ADMIN_PASSWORD=changeme

# JWT (RS256 — optional, falls back to HS256 with JWT_SECRET)
# Generate keys: python generate_keys.py
JWT_SECRET=careerneeti-secret-change-in-production
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/careerneeti
# For local dev with SQLite: DATABASE_URL=sqlite:///./careerneeti.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# LLM Defaults
DEFAULT_LLM_PROVIDER=groq
MAX_CONCURRENT_REQUESTS=5

# WhatsApp Delivery (choose one provider)
WHATSAPP_PROVIDER=                  # "meta" or "twilio"
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Monitoring (optional)
SENTRY_DSN=

# Output directory for PDFs
OUTPUT_DIR=./output

# App URLs (used in WhatsApp messages and QR codes)
APP_BASE_URL=https://careerneeti.in
CALENDLY_URL=https://calendly.com/careerneeti/15min
