# CareerNeeti backend configuration.
# Copy to .env for local development. Never commit the real .env.

# ─── Environment ──────────────────────────────────────────────────────────────
# "development" (default) permits insecure fallbacks; "production" makes the app
# refuse to start unless ADMIN_PASSWORD and JWT_SECRET are set.
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to local SQLite. Production MUST use Postgres — a SQLite file on a
# PaaS lives on an ephemeral disk and is wiped on every redeploy.
DATABASE_URL=sqlite:///./careerneeti.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. In development an ephemeral value is generated per
# process if these are blank (logins then reset on restart).
ADMIN_PASSWORD=
JWT_SECRET=
# Optional RS256 keypair; falls back to HS256 with JWT_SECRET when unset.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Report generation fails without the key for DEFAULT_LLM_PROVIDER.
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MAX_CONCURRENT_REQUESTS=5
LLM_TIMEOUT_SECONDS=90

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
# Anchored regex for additional origins. The default allows subdomains of
# careerneeti.in only. To allow Vercel previews, add your project's own prefix,
# e.g. https://frontend-[a-z0-9-]+\.vercel\.app — never a bare .*\.vercel\.app,
# which would let ANY Vercel site make credentialed requests.
CORS_ORIGIN_REGEX=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Unset = send_report_email() logs a warning and returns False.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── Misc ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://careerneeti.in
# Booking link included in the post-delivery WhatsApp message.
CALENDLY_URL=https://calendly.com/careerneeti/15min
SENTRY_DSN=
OUTPUT_DIR=
